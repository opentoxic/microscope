{
    "name": "opentoxic/microscope-adaptor-php",
    "description": "Native PHP adaptor for microscope observability",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/opentoxic/microscope",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Opentoxic\\Microscope\\Adaptor\\Php\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Opentoxic\\Microscope\\Adaptor\\Php\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
