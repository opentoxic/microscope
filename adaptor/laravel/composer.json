{
    "name": "opentoxic/microscope-adaptor-laravel",
    "description": "Laravel adaptor for microscope observability",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "opentoxic/microscope-adaptor-php": "*"
    },
    "autoload": {
        "psr-4": {
            "Opentoxic\\Microscope\\Adaptor\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Opentoxic\\Microscope\\Adaptor\\Laravel\\MicroscopeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../php"
        }
    ]
}
