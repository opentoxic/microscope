{
    "name": "qobly/microscope-client",
    "description": "Thin HTTP client for the microscope observability API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel service provider"
    },
    "autoload": {
        "psr-4": {
            "Qobly\\Microscope\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Qobly\\Microscope\\Laravel\\MicroscopeServiceProvider"
            ]
        }
    }
}
