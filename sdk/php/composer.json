{
    "name": "qobly/microscope-client",
    "description": "Thin HTTP client for the microscope observability API",
    "homepage": "https://github.com/opentoxic/microscope",
    "support": {
        "issues": "https://github.com/opentoxic/microscope/issues",
        "source": "https://github.com/opentoxic/microscope"
    },
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel service provider"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Qobly\\Microscope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qobly\\Microscope\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Qobly\\Microscope\\Laravel\\MicroscopeServiceProvider"
            ]
        }
    }
}
