{
  "name": "@opentoxic/microscope-client",
  "version": "0.1.0",
  "description": "Thin HTTP client for the microscope observability API",
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./express": {
      "types": "./dist/esm/express.d.ts",
      "import": "./dist/esm/express.js",
      "require": "./dist/cjs/express.js"
    },
    "./nestjs": {
      "types": "./dist/esm/nestjs.d.ts",
      "import": "./dist/esm/nestjs.js",
      "require": "./dist/cjs/nestjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "tsx --test test/*.test.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opentoxic/microscope"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "express": "^4.18.0 || ^5.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@types/express": "^4.17.21",
    "rxjs": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
}
